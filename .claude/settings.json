{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:studio)",
      "Bash(npm ls *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run build)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run db:generate)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git add *)",
      "Bash(git stash list*)",

      "Edit(./src/**)",
      "Edit(./public/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.env.example)",

      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:better-auth.com)",
      "WebFetch(domain:www.better-auth.com)",
      "WebFetch(domain:neon.com)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:react.dev)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update*)",
      "Bash(npx *)",
      "Bash(npm run db:push*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run auth:generate*)",
      "PowerShell(npm install*)",
      "PowerShell(npm run db:push*)",
      "PowerShell(npm run db:migrate*)",
      "PowerShell(npm run auth:generate*)",

      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",

      "Bash(rm *)",
      "PowerShell(Remove-Item *)",

      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./next.config.ts)",
      "Edit(./drizzle.config.ts)",
      "Edit(./tsconfig.json)",
      "Edit(./eslint.config.mjs)",
      "Edit(./drizzle/**)",
      "Edit(./src/db/schema.ts)",
      "Edit(./src/lib/auth.ts)",
      "Edit(./AGENTS.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",

      "Bash(npx drizzle-kit drop*)",
      "Bash(npm publish*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)"
    ]
