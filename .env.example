# Neon Postgres connection string (use the pooled connection from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client and Stripe Checkout redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (test mode only). Use a restricted key from a sandbox, never a live key:
# Dashboard > Developers > API keys > Create restricted key with
# Checkout Sessions: write, Customers: write, PaymentIntents: read.
STRIPE_SECRET_KEY="rk_test_..."
# Webhook signing secret. Locally, use the Stripe CLI's: `stripe listen --print-secret`
# (and keep `npm run stripe:listen` running next to `npm run dev`). A Dashboard endpoint has its own.
STRIPE_WEBHOOK_SECRET="whsec_..."
